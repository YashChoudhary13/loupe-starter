# Loupe — environment template. NO REAL VALUES IN THIS FILE. It is committed.
#
# The working file is `.env` in this directory. It is gitignored, it holds live
# production credentials for a real Shopify store, and it must never be committed.
# Next.js also reads `.env.local` (which overrides `.env`) — both are gitignored.
#
# Keep this template in sync when you add a variable. A variable that exists only
# in someone's local `.env` is a variable the next deploy is missing.
#
# Phase 1 uses only the four Supabase values plus SEED_ADMIN_EMAIL. Everything
# else is listed so the shape of the finished system is visible, and is unused
# until the phase named beside it.


# ── Supabase — database only, NOT storage (docs/DECISIONS.md D4) ──────────────
# Dashboard → Project Settings → API
# Phase 1.

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_… — the NEW publishable key, not the legacy anon JWT.
# Shipped to the browser. Safe only because RLS is enabled with no policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The 20-character project ref on its own, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_REF=
# SECRET. Bypasses Row Level Security. Server-side only — never NEXT_PUBLIC_,
# never logged, never returned from a route handler.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. The Postgres role password, for `npm run db:push` and the direct-
# connection tests. Dashboard → Project Settings → Database → Database password.
# This is NOT the service_role key — a JWT cannot authenticate a Postgres wire
# connection. If db:push reports SQLSTATE 28P01, this value is stale; reset it.
SUPABASE_DB_PASSWORD=

# Optional overrides. Defaults are the ap-south-1 session pooler.
# The direct host db.<ref>.supabase.co is IPv6-only; the pooler is IPv4.
# Note the shard is aws-1 for this project — aws-0 returns "tenant not found".
# SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432


# ── Console access ────────────────────────────────────────────────────────────
# Phase 1 seeds this address into app_users as the first admin (npm run seed:admin).
# Sign-in itself is Phase 4.
SEED_ADMIN_EMAIL=
# DELIBERATELY EMPTY. Authorisation is membership of `app_users`, not domain
# membership — SEED_ADMIN_EMAIL is a gmail.com address on purpose. Setting this
# to qimati.in would lock out the only admin. By design; do not "fix" it.
ALLOWED_EMAIL_DOMAIN=
# Phase 4. Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type "Web application"). The console does the code-for-token exchange itself,
# so the secret lives here and nowhere else — there is no Supabase Auth provider
# to paste it into (docs/DECISIONS.md D44).
GOOGLE_OAUTH_CLIENT_ID=
# SECRET. GOCSPX-…
GOOGLE_OAUTH_CLIENT_SECRET=
# SECRET. Signs the console session cookie. Exactly 32 random bytes as 64 hex
# characters: openssl rand -hex 32
# Rotating it signs everybody out, which is the intended emergency lever.
AUTH_SESSION_SECRET=
# The origin the console is served from, no trailing slash. NOT derived from the
# request's Host header: `${AUTH_BASE_URL}/api/auth/google/callback` must match a
# redirect URI registered on the OAuth client character for character, and a
# forged Host would otherwise move where Google sends people back to.
#   local:      http://localhost:3000
#   production: https://qimati-loupe.vercel.app
AUTH_BASE_URL=


# ── Cloudflare R2 — image storage, private bucket ─────────────────────────────
# Phase 3. Access is via presigned URLs only (docs/DECISIONS.md D4).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
# `loupe-image` — SINGULAR. Confirmed against the Cloudflare dashboard
# 2026-07-28 (location APAC). Not `loupe-images`.
R2_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=


# ── Google Drive — the photo inbox ────────────────────────────────────────────
# Phase 2. One flat RAW folder; /Processed is housekeeping only (hard rule 3).
# The service account JSON, base64-encoded so it survives being one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Folder ID only, not a Drive URL. Share this folder with the service-account email.
DRIVE_RAW_FOLDER_ID=
# Phase 4 moves published source photographs here. HOUSEKEEPING ONLY (hard rule
# 3) — nothing reads folder membership to decide what has been processed, so a
# failed move leaves a tidy-up outstanding rather than a product in doubt.
DRIVE_PROCESSED_FOLDER_ID=


# ── Image enhancement ─────────────────────────────────────────────────────────
# Phase 3. docs/DECISIONS.md D5: gpt-image-2 reached THROUGH OpenRouter, and
# deliberately NOT pinned to a dated snapshot. The mitigation for style drift is
# that image_versions records `model` and `prompt_text` on every row, so any
# published image traces back to the exact model and prompt that made it.
# There is deliberately no OPENAI_API_KEY — OpenAI is reached via OpenRouter.
OPENROUTER_API_KEY=
# Both friendly names are resolved to the exact OpenRouter slugs persisted in
# the database (`openai/gpt-5.6-sol`, `openai/gpt-image-2`).
DESCRIBE_MODEL=gpt-5.6-sol
# Deliberately enforced as minimal. Reasoning tokens bill at output rates.
DESCRIBE_REASONING_EFFORT=minimal
INJECT_DESCRIPTION=true
IMAGE_MODEL=gpt-image-2
# Explicit on every request. Never rely on OpenRouter/provider defaults: the image
# itself is the first place a cost misconfiguration must become visible.
IMAGE_SIZE=1280x1280
IMAGE_QUALITY=medium
MAX_COST_USD_PER_IMAGE=0.20
MAX_COST_USD_PER_DESCRIPTION=0.02
OPENROUTER_GEMINI_MODEL=
# Direct-to-Google fallback for when OpenRouter itself is unavailable.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=


# ── Shopify — server-side only, never exposed ─────────────────────────────────
# Phase 2. Publishing is idempotent by handle (hard rule 2).
#
# Auth is the OAuth `client_credentials` grant, NOT a static shpat_ token. The
# id and secret are exchanged at POST /admin/oauth/access_token for an offline
# token that expires in 24 h. There is nothing long-lived to paste here; the
# token manager caches, refreshes proactively and retries once on 401.
#
# <store>.myshopify.com — the TEST store is `qimti` (no second "a"). That is
# correct, not a typo. The live store is a later cutover.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_AUTH_MODE=client_credentials
SHOPIFY_CLIENT_ID=
# SECRET. shpss_…
SHOPIFY_CLIENT_SECRET=
# Optional. Defaults to the version pinned in src/lib/shopify/config.ts.
SHOPIFY_API_VERSION=


# ── Guards ────────────────────────────────────────────────────────────────────
# SECRET. Supabase pg_net sends this as `Authorization: Bearer …`.
# Generate exactly 32 random bytes as hex: openssl rand -hex 32
CRON_SECRET=
# Stable production origin used by the scheduler, without a trailing slash.
# Example: https://loupe.example.com
CRON_BASE_URL=

# Set to `production` to make destructive scripts (npm run db:reset) refuse.
LOUPE_ENV=
