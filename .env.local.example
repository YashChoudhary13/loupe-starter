# Loupe — environment template. NO REAL VALUES IN THIS FILE. It is committed.
#
# The working file is `.env` in this directory. It is gitignored, it holds live
# production credentials for a real Shopify store, and it must never be committed.
# Next.js also reads `.env.local` (which overrides `.env`) — both are gitignored.
#
# Keep this template in sync when you add a variable. A variable that exists only
# in someone's local `.env` is a variable the next deploy is missing.
#
# Phase 1 uses only the four Supabase values plus SEED_ADMIN_EMAIL. Everything
# else is listed so the shape of the finished system is visible, and is unused
# until the phase named beside it.


# ── Supabase — database only, NOT storage (docs/DECISIONS.md D4) ──────────────
# Dashboard → Project Settings → API
# Phase 1.

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_… — the NEW publishable key, not the legacy anon JWT.
# Shipped to the browser. Safe only because RLS is enabled with no policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The 20-character project ref on its own, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_REF=
# SECRET. Bypasses Row Level Security. Server-side only — never NEXT_PUBLIC_,
# never logged, never returned from a route handler.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. The Postgres role password, for `npm run db:push` and the direct-
# connection tests. Dashboard → Project Settings → Database → Database password.
# This is NOT the service_role key — a JWT cannot authenticate a Postgres wire
# connection. If db:push reports SQLSTATE 28P01, this value is stale; reset it.
SUPABASE_DB_PASSWORD=

# Optional overrides. Defaults are the ap-south-1 session pooler.
# The direct host db.<ref>.supabase.co is IPv6-only; the pooler is IPv4.
# Note the shard is aws-1 for this project — aws-0 returns "tenant not found".
# SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432


# ── Console access ────────────────────────────────────────────────────────────
# Phase 1 seeds this address into app_users as the first admin (npm run seed:admin).
# Sign-in itself is Phase 4.
SEED_ADMIN_EMAIL=
# Google sign-in is restricted to this domain (CLAUDE.md hard rule 7).
# NOTE: if SEED_ADMIN_EMAIL is not on this domain, Phase 4 must make an explicit
# exception for it or the only admin cannot sign in.
ALLOWED_EMAIL_DOMAIN=
# Phase 4. Google Cloud console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=


# ── Cloudflare R2 — image storage, private bucket ─────────────────────────────
# Phase 3. Access is via presigned URLs only (docs/DECISIONS.md D4).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
# Confirm against the Cloudflare dashboard — CLAUDE.md says `loupe-images`,
# the working .env says `loupe-image`. One of them is wrong.
R2_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=


# ── Google Drive — the photo inbox ────────────────────────────────────────────
# Phase 2. One flat RAW folder; /Processed is housekeeping only (hard rule 3).
# The service account JSON, base64-encoded so it survives being one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_RAW_FOLDER_ID=
DRIVE_PROCESSED_FOLDER_ID=


# ── Image enhancement ─────────────────────────────────────────────────────────
# Phase 3. docs/DECISIONS.md D5 settled on OpenAI gpt-image-2 pinned to a dated
# snapshot. The working .env currently also carries Gemini and OpenRouter keys,
# which is a live bake-off, not a settled choice — resolve before Phase 3.
# NEVER use a moving pointer like chatgpt-image-latest: the catalogue's look
# would drift silently as ChatGPT's model moves.
OPENAI_API_KEY=
# e.g. gpt-image-2-2026-04-21
OPENAI_IMAGE_MODEL=
# Alternatives under evaluation — remove the losers once D5 is confirmed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_GEMINI_MODEL=
OPENROUTER_OPENAI_IMAGE_MODEL=


# ── Shopify — server-side only, never exposed ─────────────────────────────────
# Phase 5. Publishing is idempotent by handle (hard rule 2).
# <store>.myshopify.com
SHOPIFY_STORE_DOMAIN=
# `client_credentials` in the working .env. CLAUDE.md hard rule 7 describes a
# long-lived admin token instead. Confirm which the custom app actually uses.
SHOPIFY_AUTH_MODE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SECRET. shpat_… — shown once at install, if using token auth.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=


# ── Guards ────────────────────────────────────────────────────────────────────
# Set to `production` to make destructive scripts (npm run db:reset) refuse.
LOUPE_ENV=
